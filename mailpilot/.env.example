# Supabase (anon key is safe for the browser; NEVER expose the service-role key client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 3
# 32 random bytes, base64: openssl rand -base64 32   (losing it makes stored tokens unreadable)
TOKEN_ENCRYPTION_KEY=
# Google Cloud: OAuth client (Web). Redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/oauth/google/callback. Scopes: openid, email, gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One platform Resend account hosts every tenant's verified domain
RESEND_API_KEY=

# Phase 5: AI drafting (optional; without it the composer shows an honest "not configured" note)
# AI_PROVIDER=anthropic uses the Anthropic API; AI_PROVIDER=openai works with OpenAI or any OpenAI-compatible endpoint.
AI_PROVIDER=
AI_API_KEY=
# Anthropic defaults to claude-haiku-5-5. OpenAI-compatible providers need an explicit model name.
AI_MODEL=
# Optional override, e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1
AI_BASE_URL=
# AI drafts per user per day (default 20, max 500)
AI_DAILY_LIMIT=20

# Phase 6: sending queue
# Secret that lets a scheduler call GET /api/worker/tick (Authorization: Bearer <secret>). Without it the route refuses to run.
CRON_SECRET=
# Resend dashboard -> Webhooks -> signing secret (whsec_...). Without it the webhook route refuses to run and messages never reach "Delivered".
RESEND_WEBHOOK_SECRET=
# All optional; defaults shown. Invalid values fall back to the default.
# SEND_MAX_ATTEMPTS=4          # tries per message (1-10)
# SEND_RETRY_BASE_SECONDS=30   # first retry delay; x4 each time, capped at 6 h
# SENDER_MAX_PER_MINUTE=60     # ceiling per sender account across campaigns
# USER_DAILY_SEND_LIMIT=500    # rolling 24 h cap per user
# QUOTA_PAUSE_MINUTES=30       # first pause after a provider quota error; doubles up to 24 h
# WORKER_BATCH_SIZE=10
# WORKER_CONCURRENCY=4
# WORKER_LEASE_SECONDS=120     # a job not finished by then is treated as a crashed worker's (min 30; provider calls time out at 20 s)
# WORKER_IDLE_MS=3000          # npm run worker: pause between rounds

# Local development only: test emails are simulated and NOTHING is sent. Ignored when NODE_ENV=production.
MAILPILOT_MOCK_PROVIDER=
